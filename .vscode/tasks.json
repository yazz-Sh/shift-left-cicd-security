// Lancer un controle depuis VS Code : Terminal > Run Task > Scan securite : ...
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Scan securite : gitleaks",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/scan-local.ps1",
        "-Only",
        "gitleaks"
      ],
      "problemMatcher": []
    },
